      "model": {
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "editorMode": "code",
        "expr": "sum by (host) (\n  count_over_time(\n    {\n      job=~\"systemd-journal|syslog\",\n      transport=~\"kernel|\",\n      service!=\"syslog\"\n    }\n    |~ \"(?i)(PCIe Bus Error.*severity=Correctable|AER: Correctable error received)\"\n    [5m]\n  )\n)",
