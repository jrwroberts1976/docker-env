{
  "uid": "cfvnpciaerwarn01",
  "orgID": 1,
  "folderUID": "homelab-alerts",
  "ruleGroup": "Hardware Health",
  "title": "Correctable PCIe error detected",
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "queryType": "range",
      "relativeTimeRange": {
        "from": 300,
